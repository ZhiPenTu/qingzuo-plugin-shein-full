{
  "name": "@commerce/plugin-shein-full",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "commerce": {
    "manifestVersion": 1,
    "id": "official.shein-full",
    "title": "希音全托管铺货",
    "description": "从 1688 采集商品，翻译成英文并生成希音全托管草稿，人工审核确认后才提交发品",
    "category": "电商工具",
    "api": "^1.3.0",
    "ui": "ui/index.html",
    "releaseNotes": "首版：1688 商品页结构化采集、图文翻译、图片转存与校验、希音全托管草稿审核与人工确认提交。",
    "permissions": {
      "files": true,
      "storage": true,
      "credentials": [
        "shein-secret-key",
        "openai-api-key",
        "deepseek-api-key"
      ],
      "network": [
        "https://openapi.sheincorp.com",
        "https://openapi-test01.sheincorp.cn",
        "https://api.openai.com",
        "https://api.deepseek.com"
      ],
      "networkHeaders": [
        "Content-Type",
        "language",
        "x-lt-openKeyId",
        "x-lt-timestamp",
        "x-lt-signature"
      ],
      "browser": [
        "automate"
      ],
      "browserOrigins": [
        "https://detail.1688.com",
        "https://m.1688.com",
        "https://www.1688.com"
      ]
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "pack": "node scripts/pack-plugin.mjs",
    "test:host": "node tests/host.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@commerce/plugin-sdk": "file:vendor/commerce-plugin-sdk-1.3.0.tgz"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0"
  },
  "license": "MIT"
}
