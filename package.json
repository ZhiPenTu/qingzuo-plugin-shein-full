{
  "name": "@commerce/plugin-shein-full",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "commerce": {
    "manifestVersion": 1,
    "id": "official.shein-full",
    "title": "希音全托管铺货",
    "description": "从 1688 采集商品，翻译成英文并生成希音全托管草稿，人工审核确认后才提交发品",
    "category": "电商工具",
    "api": "^1.4.0",
    "ui": "ui/index.html",
    "releaseNotes": "希音类目改为授权后按店铺可用类目逐级选择，选到末级自动带入 product_type_id，不再需要手填类目 ID；已选类目与完整路径会显示在选择器下方。",
    "permissions": {
      "files": true,
      "storage": true,
      "credentials": [
        "shein-app-secret",
        "shein-secret-key"
      ],
      "network": [
        "https://openapi.sheincorp.com",
        "https://openapi-test01.sheincorp.cn"
      ],
      "networkHeaders": [
        "Content-Type",
        "language",
        "x-lt-appid",
        "x-lt-openKeyId",
        "x-lt-timestamp",
        "x-lt-signature"
      ],
      "browser": [
        "automate"
      ],
      "browserOrigins": [
        "https://detail.1688.com",
        "https://m.1688.com",
        "https://www.1688.com",
        "https://openapi.sheincorp.com",
        "https://openapi-sem.sheincorp.com",
        "https://openapi-test01.sheincorp.cn"
      ],
      "ai": [
        "image-edit",
        "text"
      ]
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "pack": "node scripts/pack-plugin.mjs",
    "test:host": "node tests/host.mjs",
    "test:e2e": "playwright test",
    "preview": "node scripts/preview.mjs"
  },
  "dependencies": {
    "@commerce/plugin-sdk": "file:vendor/commerce-plugin-sdk-1.4.0.tgz"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0"
  },
  "license": "MIT"
}
