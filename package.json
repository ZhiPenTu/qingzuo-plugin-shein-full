{
  "name": "@commerce/plugin-shein-full",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "commerce": {
    "manifestVersion": 1,
    "id": "official.shein-full",
    "title": "希音全托管铺货",
    "description": "从 1688 采集商品，翻译成英文并生成希音全托管草稿，人工审核确认后才提交发品",
    "category": "电商工具",
    "api": "^1.4.0",
    "ui": "ui/index.html",
    "releaseNotes": "希音店铺授权改在插件内完成：填好 APP_ID 与 APP_SecretKey 后点「连接希音」，在内嵌浏览器里确认授权，插件自动读回授权结果并保存店铺凭据，不再需要去开放平台复制授权码。",
    "permissions": {
      "files": true,
      "storage": true,
      "credentials": [
        "shein-app-secret",
        "shein-secret-key"
      ],
      "network": [
        "https://openapi.sheincorp.com",
        "https://openapi-test01.sheincorp.cn"
      ],
      "networkHeaders": [
        "Content-Type",
        "language",
        "x-lt-appid",
        "x-lt-openKeyId",
        "x-lt-timestamp",
        "x-lt-signature"
      ],
      "browser": [
        "automate"
      ],
      "browserOrigins": [
        "https://detail.1688.com",
        "https://m.1688.com",
        "https://www.1688.com",
        "https://openapi.sheincorp.com",
        "https://openapi-sem.sheincorp.com",
        "https://openapi-test01.sheincorp.cn"
      ],
      "ai": [
        "image-edit",
        "text"
      ]
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "pack": "node scripts/pack-plugin.mjs",
    "test:host": "node tests/host.mjs",
    "test:e2e": "playwright test",
    "preview": "node scripts/preview.mjs"
  },
  "dependencies": {
    "@commerce/plugin-sdk": "file:vendor/commerce-plugin-sdk-1.4.0.tgz"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0"
  },
  "license": "MIT"
}
